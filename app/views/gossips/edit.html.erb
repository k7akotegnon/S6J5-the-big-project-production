<div class="container">
  <h1>Modifier le potin</h1>

  <% if @gossip.errors.any? %>
    <div class="alert alert-danger">
      <p>Erreur lors de la modification :</p>
      <ul>
        <% @gossip.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Remarque l'URL dynamique gossip_path(@gossip.id) et le verbe PATCH pour l'update %>
  <%= form_tag gossip_path(@gossip.id), method: :patch do %>
    <div class="form-group">
      <label>Titre</label>
      <%= text_field_tag "title", @gossip.title, class: "form-control" %>
    </div>
    <div class="form-group">
      <label>Contenu</label>
      <%= text_area_tag "content", @gossip.content, class: "form-control" %>
    </div>
    <button type="submit" class="btn btn-primary">Mettre à jour</button>
  <% end %>
</div>
