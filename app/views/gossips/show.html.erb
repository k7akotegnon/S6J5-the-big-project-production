<div class="card p-4 shadow">
  <!-- Affichage du titre et des métadonnées -->
  <h1 class="display-4"><%= @gossip.title %></h1>
  <p class="text-muted">
    Écrit par : <%= link_to @gossip.user.first_name, user_path(@gossip.user.id) %>
    dans la ville de <%= link_to @gossip.user.city.name, city_path(@gossip.user.city.id) %>
  </p>
  <hr>

  <!-- Contenu du potin -->
  <p class="lead"><%= @gossip.content %></p>

  <hr>

  <!-- Boutons d'action CRUD -->
  <div class="d-flex justify-content-between">
    <%= link_to "Retour à l'accueil", root_path, class: "btn btn-secondary" %>
    <div>
      <%= link_to "Modifier", edit_gossip_path(@gossip.id), class: "btn btn-warning" %>
      <%= button_to "Supprimer", gossip_path(@gossip), method: :delete, data: { turbo_confirm: "Es-tu certain ?" }, class: "btn btn-danger d-inline" %>

    </div>
  </div>
</div>
