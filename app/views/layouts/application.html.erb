<!DOCTYPE html>
<html>
  <head>
    <title>TheGossipProject</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= javascript_importmap_tags %>
    <!-- CDN Bootstrap -->
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css">
  </head>

  <body>
    <!-- 1. TA NAVBAR (Commune à toutes les pages) -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <%= link_to "Gossip Project", root_path, class: "navbar-brand" %>
      <div class="navbar-nav mr-auto">
        <%= link_to "L'Équipe", team_path, class: "nav-link" %>
        <%= link_to "Contact", contact_path, class: "nav-link" %>
      </div>
      <div class="navbar-nav ml-auto">
        <% if logged_in? %>
          <%# Utilise "data: { turbo_method: :delete }" pour envoyer la bonne requête %>
          <%= link_to "Déconnexion", session_path(current_user.id), data: { turbo_method: :delete }, class: "nav-link text-danger" %>

        <% else %>
          <%= link_to "S'inscrire", new_user_path, class: "nav-link" %>
          <%= link_to "Se connecter", new_session_path, class: "nav-link" %>
        <% end %>
      </div>
    </nav>

    <!-- 2. LES MESSAGES FLASH -->
    <div class="container">
      <% flash.each do |type, msg| %>
        <div class="alert alert-<%= type == 'success' ? 'success' : 'info' %>">
          <%= msg %>
        </div>
      <% end %>

      <!-- 3. LE CONTENU DYNAMIQUE (C'est ICI que Team ou Contact s'affichera) -->
      <%= yield %>
    </div>
  </body>
</html>
