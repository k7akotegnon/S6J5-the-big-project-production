<div class="container mt-5">
  <div class="row">
    <div class="col-md-6 offset-md-3">
      <div class="card shadow p-4">
        <h1 class="text-center mb-4">S'inscrire</h1>

        <%# 1. Gestion des erreurs de validation %>
        <% if @user.errors.any? %>
          <div class="alert alert-danger">
            <p>Le formulaire contient <%= @user.errors.count %> erreur(s) :</p>
            <ul>
              <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <%# 2. Formulaire d'inscription %>
        <%= form_tag users_path, method: :post do %>
          
          <%# Champ caché généré pour la sécurité CSRF %>
          <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">

          <div class="form-group mb-3">
            <label>Prénom</label>
            <%= text_field_tag 'first_name', @user.first_name, class: 'form-control', placeholder: "Ton prénom" %>
          </div>

          <div class="form-group mb-3">
            <label>Nom</label>
            <%= text_field_tag 'last_name', @user.last_name, class: 'form-control', placeholder: "Ton nom de famille" %>
          </div>

          <div class="form-group mb-3">
            <label>Âge</label>
            <%= number_field_tag 'age', @user.age, class: 'form-control', placeholder: "Ton âge" %>
          </div>

          <div class="form-group mb-3">
            <label>Email</label>
            <%= email_field_tag 'email', @user.email, class: 'form-control', placeholder: "exemple@email.com" %>
          </div>

          <div class="form-group mb-3">
            <label>Description</label>
            <%= text_area_tag 'description', @user.description, class: 'form-control', placeholder: "Dis-nous en un peu plus sur toi..." %>
          </div>

          <div class="form-group mb-4">
            <label>Mot de passe (6 caractères minimum)</label>
            <%= password_field_tag 'password', nil, class: 'form-control', placeholder: "Ton mot de passe" %>
          </div>

          <div class="text-center">
            <button type="submit" class="btn btn-success btn-lg w-100">Créer mon compte</button>
          </div>

        <% end %>

        <div class="text-center mt-3">
          <small>Déjà un compte ? <%= link_to "Se connecter", new_session_path %></small>
        </div>
      </div>
    </div>
  </div>
</div>
