<div class="container mt-5">
  <div class="card shadow-sm p-4">
    <h1 class="text-primary">Profil de <%= @user.first_name %> <%= @user.last_name %></h1>
    <hr>
    <p><strong>Âge :</strong> <%= @user.age %> ans</p>
    <p><strong>Email :</strong> <%= @user.email %></p>
    <p><strong>Ville :</strong> <%= link_to @user.city.name, city_path(@user.city.id) %> (<%= @user.city.zip_code %>)</p>
    <hr>
    <p><strong>Description :</strong></p>
    <p class="font-italic text-secondary"><%= @user.description %></p>

    <div class="mt-4">
      <%= link_to "Retour", :back, class: "btn btn-outline-primary" %>
    </div>
  </div>
</div>
